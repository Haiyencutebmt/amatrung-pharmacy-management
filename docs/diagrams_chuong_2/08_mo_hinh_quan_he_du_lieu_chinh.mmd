%% Hình 2.8. Mô hình quan hệ dữ liệu chính của website quản lý nhà thuốc YHCT AmaTrung
%% Chỉ gồm các bảng nghiệp vụ chính, không đưa bảng hệ thống Laravel và bảng legacy/cũ.
flowchart TB
    classDef account fill:#eef2ff,stroke:#4f46e5,color:#111827,stroke-width:1.5px
    classDef clinical fill:#ecfdf5,stroke:#059669,color:#111827,stroke-width:1.5px
    classDef treatment fill:#fff7ed,stroke:#ea580c,color:#111827,stroke-width:1.5px
    classDef inventory fill:#eff6ff,stroke:#2563eb,color:#111827,stroke-width:1.5px
    classDef content fill:#fdf2f8,stroke:#db2777,color:#111827,stroke-width:1.5px
    classDef dictionary fill:#f0fdfa,stroke:#0f766e,color:#111827,stroke-width:1.5px
    classDef ai fill:#f8fafc,stroke:#475569,color:#111827,stroke-width:1.5px
    classDef note fill:#ffffff,stroke:#94a3b8,color:#111827,stroke-dasharray: 4 4

    subgraph G1["Tài khoản và phân quyền"]
        users["users<br/>PK: id<br/>role, is_active"]
        roles["roles<br/>PK: id"]
        permissions["permissions<br/>PK: id"]
        model_has_roles["model_has_roles<br/>FK: role_id<br/>model_id, model_type"]
        model_has_permissions["model_has_permissions<br/>FK: permission_id<br/>model_id, model_type"]
        role_has_permissions["role_has_permissions<br/>FK: role_id, permission_id"]
    end

    subgraph G2["Bệnh nhân và hồ sơ bệnh án"]
        patients["patients<br/>PK: id<br/>UK: patient_code<br/>FK: user_id"]
        patient_user_links["patient_user_links<br/>FK: patient_id, user_id<br/>is_verified"]
        medical_records["medical_records<br/>PK: id<br/>UK: record_code<br/>symptoms, diagnosis, status"]
        medical_record_attachments["medical_record_attachments<br/>FK: medical_record_id<br/>uploaded_by"]
        appointments["appointments<br/>FK: patient_id<br/>appointment_date, status"]
    end

    subgraph G3["Đơn điều trị và dịch vụ"]
        prescriptions["prescriptions<br/>FK: medical_record_id, staff_id<br/>status, follow_up_date"]
        prescription_items["prescription_items<br/>FK: prescription_id<br/>FK: inventory_item_id<br/>quantity, affects_stock"]
        therapy_services["therapy_services<br/>PK: id<br/>name, default_sessions"]
    end

    subgraph G4["Kho dược liệu theo lô"]
        inventory_items["inventory_items<br/>PK: id<br/>name, item_type, usage_route"]
        inventory_batches["inventory_batches<br/>FK: inventory_item_id<br/>batch_number, expiry_date"]
        stock_movements["stock_movements<br/>FK: inventory_batch_id<br/>FK: prescription_item_id<br/>movement_type, quantity"]
    end

    subgraph G5["Bài viết và bình luận"]
        articles["articles<br/>FK: user_id<br/>title, slug, is_published"]
        comments["comments<br/>FK: article_id, user_id<br/>content, is_approved"]
        article_likes["article_likes<br/>FK: article_id, user_id<br/>unique(article_id,user_id)"]
    end

    subgraph G6["Từ điển dược liệu"]
        herb_dictionary_entries["herb_dictionary_entries<br/>FK: created_by<br/>name, slug, status"]
        herb_dictionary_images["herb_dictionary_images<br/>FK: entry_id<br/>image_path"]
        herb_dictionary_favorites["herb_dictionary_favorites<br/>FK: user_id, entry_id<br/>unique(user_id,entry_id)"]
    end

    subgraph G7["Trí tuệ nhân tạo"]
        ai_suggestion_logs["ai_suggestion_logs<br/>FK: user_id<br/>FK: medical_record_id<br/>payload, response, status"]
    end

    note1["Ghi chú:<br/>Admin/Thầy thuốc chính quyết định chuyên môn.<br/>Staff là nhân viên được Admin cấp quyền.<br/>AI chỉ lưu nhật ký hỗ trợ tham khảo, không tự tạo đơn và không tự trừ kho.<br/>Kho chính dùng inventory_items, inventory_batches, stock_movements."]

    roles -->|1-N| model_has_roles
    users -.->|1-N qua model_id| model_has_roles
    permissions -->|1-N| model_has_permissions
    users -.->|1-N qua model_id| model_has_permissions
    roles -->|1-N| role_has_permissions
    permissions -->|1-N| role_has_permissions

    users -->|1-N nếu có user_id| patients
    users -->|1-N| patient_user_links
    patients -->|1-N| patient_user_links
    patients -->|1-N| medical_records
    users -->|1-N staff_id| medical_records
    medical_records -->|1-N| medical_record_attachments
    users -.->|1-N uploaded_by| medical_record_attachments
    patients -->|1-N| appointments

    medical_records -->|1-N| prescriptions
    users -->|1-N staff_id| prescriptions
    prescriptions -->|1-N| prescription_items
    therapy_services -.->|ghi vào prescription_items| prescription_items

    inventory_items -->|1-N| inventory_batches
    inventory_items -->|1-N| prescription_items
    inventory_batches -->|1-N| stock_movements
    prescription_items -->|0-N| stock_movements
    users -->|1-N performed_by| stock_movements

    users -->|1-N tạo| articles
    articles -->|1-N| comments
    users -->|1-N tạo| comments
    articles -->|1-N| article_likes
    users -->|1-N| article_likes

    users -->|1-N created_by| herb_dictionary_entries
    herb_dictionary_entries -->|1-N| herb_dictionary_images
    herb_dictionary_entries -->|1-N| herb_dictionary_favorites
    users -->|1-N| herb_dictionary_favorites

    users -->|1-N| ai_suggestion_logs
    medical_records -->|1-N| ai_suggestion_logs

    class users,roles,permissions,model_has_roles,model_has_permissions,role_has_permissions account
    class patients,patient_user_links,medical_records,medical_record_attachments,appointments clinical
    class prescriptions,prescription_items,therapy_services treatment
    class inventory_items,inventory_batches,stock_movements inventory
    class articles,comments,article_likes content
    class herb_dictionary_entries,herb_dictionary_images,herb_dictionary_favorites dictionary
    class ai_suggestion_logs ai
    class note1 note
