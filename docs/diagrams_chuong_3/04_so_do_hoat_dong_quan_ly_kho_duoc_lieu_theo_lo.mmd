%% Hình 2.x. Sơ đồ hoạt động quản lý kho dược liệu theo lô trong hệ thống AmaTrung
flowchart TD
    A([Bắt đầu])
    B[Mở chức năng quản lý kho dược liệu]
    C{Chọn nghiệp vụ kho}

    D[Thêm / cập nhật dược liệu trong danh mục inventory_items]
    E[Nhập thông tin lô: số lô, hạn dùng, số lượng, đơn vị]
    F{Thông tin lô hợp lệ?}
    G[Thông báo lỗi nhập lô]
    H[Lưu lô vào inventory_batches]
    I[Ghi nhận biến động nhập kho nếu có]

    J[Tiếp nhận yêu cầu cấp thuốc từ đơn điều trị]
    K{Đơn có thuốc ảnh hưởng kho?}
    L[Lưu đơn / in đơn, không trừ kho]
    M[Kiểm tra tồn kho khả dụng theo lô]
    N{Đủ tồn kho?}
    O[Cảnh báo thiếu kho hoặc lô hết hạn]
    P[Admin / Thầy thuốc chính xác nhận cấp thuốc]
    Q[Trừ số lượng trên từng lô]
    R[Ghi stock_movements]
    S[Cập nhật tồn kho còn lại]
    T[Lưu kết quả và hoàn tất]
    U([Kết thúc])

    A --> B --> C
    C -- "Nhập / cập nhật kho" --> D --> E --> F
    F -- "Không" --> G --> E
    F -- "Có" --> H --> I --> T

    C -- "Cấp thuốc theo đơn" --> J --> K
    K -- "Không" --> L --> T
    K -- "Có" --> M --> N
    N -- "Không đủ" --> O --> T
    N -- "Đủ" --> P --> Q --> R --> S --> T --> U

    note1["Kho chính sử dụng inventory_items, inventory_batches và stock_movements."]
    note2["Chỉ khi xác nhận cấp thuốc mới trừ kho theo lô."]
    note3["AI không tự trừ kho; kho được xử lý theo nghiệp vụ cấp thuốc."]

    H -.-> note1
    P -.-> note2
    R -.-> note3

    classDef startEnd fill:#111827,stroke:#111827,color:#ffffff,stroke-width:2px;
    classDef process fill:#ffffff,stroke:#334155,color:#0f172a,stroke-width:2px;
    classDef admin fill:#eff6ff,stroke:#2563eb,color:#0f172a,stroke-width:2px;
    classDef stock fill:#f0fdf4,stroke:#16a34a,color:#0f172a,stroke-width:2px;
    classDef decision fill:#fefce8,stroke:#ca8a04,color:#0f172a,stroke-width:2px;
    classDef warning fill:#fef2f2,stroke:#dc2626,color:#0f172a,stroke-width:2px;
    classDef note fill:#f8fafc,stroke:#64748b,color:#334155,stroke-width:1.5px,stroke-dasharray:6 5;

    class A,U startEnd;
    class B,D,E,J,L,T process;
    class P admin;
    class H,I,M,Q,R,S stock;
    class C,F,K,N decision;
    class G,O warning;
    class note1,note2,note3 note;
