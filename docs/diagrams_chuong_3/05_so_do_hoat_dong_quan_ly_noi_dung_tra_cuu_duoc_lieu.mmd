%% Hình 2.x. Sơ đồ hoạt động quản lý nội dung và tra cứu dược liệu trong hệ thống AmaTrung
flowchart TD
    A([Bắt đầu])
    B{Người dùng chọn chức năng}

    C[Admin / Staff có quyền mở quản lý bài viết]
    D[Tạo / cập nhật bài viết]
    E{Xuất bản bài viết?}
    F[Lưu nháp]
    G[Công khai bài viết]
    H[Người dùng xem bài viết]
    I{Người dùng đã đăng nhập?}
    J[Đăng nhập để tương tác]
    K[Bình luận hoặc thích bài viết]
    L{Bình luận cần duyệt?}
    M[Admin / Staff duyệt bình luận]
    N[Hiển thị bình luận / lượt thích]

    O[Admin / Staff có quyền mở quản lý từ điển dược liệu]
    P[Tạo / cập nhật mục dược liệu]
    Q[Thêm hình ảnh, mô tả, công dụng, trạng thái]
    R{Mục dược liệu được kích hoạt?}
    S[Lưu nội bộ / chưa hiển thị]
    T[Công khai mục tra cứu]
    U[Người dùng tra cứu từ điển dược liệu]
    V{Người dùng đã đăng nhập?}
    W[Đăng nhập để lưu yêu thích]
    X[Thêm / bỏ yêu thích dược liệu]

    Y[Lưu kết quả xử lý]
    Z([Kết thúc])

    A --> B
    B -- "Quản lý bài viết" --> C --> D --> E
    E -- "Không" --> F --> Y
    E -- "Có" --> G --> H --> I
    I -- "Không" --> J --> H
    I -- "Có" --> K --> L
    L -- "Có" --> M --> N --> Y
    L -- "Không" --> N --> Y

    B -- "Tra cứu / quản lý dược liệu" --> O --> P --> Q --> R
    R -- "Không" --> S --> Y
    R -- "Có" --> T --> U --> V
    V -- "Không" --> W --> U
    V -- "Có" --> X --> Y

    note1["Admin / Thầy thuốc chính quản lý toàn bộ nội dung; Staff thao tác theo quyền được cấp."]
    note2["User có thể xem bài viết, bình luận, thích bài viết, tra cứu và lưu yêu thích dược liệu."]
    note3["Nhóm chức năng này phục vụ nội dung và tra cứu, không phải luồng điều trị chính."]

    C -.-> note1
    K -.-> note2
    U -.-> note3

    classDef startEnd fill:#111827,stroke:#111827,color:#ffffff,stroke-width:2px;
    classDef process fill:#ffffff,stroke:#334155,color:#0f172a,stroke-width:2px;
    classDef admin fill:#eff6ff,stroke:#2563eb,color:#0f172a,stroke-width:2px;
    classDef user fill:#f0fdf4,stroke:#16a34a,color:#0f172a,stroke-width:2px;
    classDef decision fill:#fefce8,stroke:#ca8a04,color:#0f172a,stroke-width:2px;
    classDef warning fill:#fef2f2,stroke:#dc2626,color:#0f172a,stroke-width:2px;
    classDef note fill:#f8fafc,stroke:#64748b,color:#334155,stroke-width:1.5px,stroke-dasharray:6 5;

    class A,Z startEnd;
    class D,F,G,N,P,Q,S,T,Y process;
    class C,M,O admin;
    class H,K,U,X user;
    class B,E,I,L,R,V decision;
    class J,W warning;
    class note1,note2,note3 note;
